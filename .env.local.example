# Copy this to .env.local and fill in your values.
# Get these from your Supabase project: Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used only by seed/scraper scripts (never exposed to the browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used by the scraper for LLM parsing
ANTHROPIC_API_KEY=your-anthropic-api-key

# Fine-grained PAT with Issues: Read & Write on this repo (for feedback widget)
GITHUB_TOKEN=your-github-pat

# Secret key for the admin theater-edit page (/admin/theaters/[id]?key=...)
ADMIN_KEY=your-secret-key
